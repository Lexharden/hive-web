---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import DonateMethods from '../components/DonateMethods.astro';
import TierBadge from '../components/TierBadge.astro';
import DonorWall from '../components/DonorWall.astro';
import { site, support, sponsors, donors, apps, games } from '../config/site';
import { getReleases } from '../lib/releases';

// Cifras reales del trabajo, leídas de los releases de cada app y port.
const repos = [apps.hiveshock.repo, apps.hivebuzz.repo, ...games.filter((g) => g.repo).map((g) => g.repo!)];
const all = await Promise.all(repos.map((r) => getReleases(r)));
const versions = all.reduce((n, r) => n + r.releases.length, 0);
const stats = [
  { n: String(versions), label: 'versiones publicadas' },
  { n: String(Object.keys(apps).length + games.length), label: 'apps, ports y mods con soporte' },
  { n: '4', label: 'plataformas: Windows, macOS, Linux y Android' },
  { n: '1', label: 'persona detrás de todo' },
];

const faq = [
  {
    q: '¿Donar desbloquea algo en las apps?',
    a: '<p>No. HiveShock y HiveBuzz son iguales para todos. Las donaciones mantienen el proyecto gratis, no compran funciones.</p>',
  },
  {
    q: '¿Cómo aparezco en el muro de donadores?',
    a: `<p><strong>Ko-fi:</strong> marca tu donación como pública y apareces en unos minutos.</p><p><strong>PayPal o SPEI:</strong> mándame por <a href="${site.links.discord}" target="_blank" rel="noopener">Discord</a> el nombre que quieres mostrar y, si quieres, tus canales de TikTok, Twitch, YouTube o Kick. Si no me dices nada, tu donación queda privada.</p>`,
  },
  {
    q: '¿Se publica cuánto doné?',
    a: '<p>No. En la web solo aparece el nombre que elijas. Los montos nunca se muestran por persona.</p>',
  },
  {
    q: '¿Qué método me conviene?',
    a: '<p>Desde México, la transferencia SPEI no cobra comisión y el apoyo llega completo. Desde otro país, PayPal o Ko-fi. Ko-fi también permite apoyar cada mes.</p>',
  },
  {
    q: 'Quiero patrocinar como marca o equipo',
    a: `<p>Escríbeme en <a href="${site.links.discord}" target="_blank" rel="noopener">Discord</a> y armamos un patrocinio a la medida: logo en la web, mención en las versiones o colaboraciones en directo.</p>`,
  },
  {
    q: '¿Hay otras formas de ayudar?',
    a: '<p>Sí: reporta errores, prueba las versiones de prueba en tu plataforma, comparte tus perfiles de regalos y recomienda las apps a otros streamers. Todo eso ayuda tanto como una donación.</p>',
  },
];
---
<Base title="Apoya el proyecto" description="Apoya HiveShock y HiveBuzz por PayPal, Ko-fi o transferencia SPEI. Las apps son y seguirán siendo gratis.">
  <section class="hero honeycomb">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>Apoya a la colmena</h1>
        <p class="lead">
          HiveShock y HiveBuzz son gratis y lo seguirán siendo. No tienen anuncios, versión de pago ni funciones bloqueadas.
          Lo que cuesta mantenerlas lo cubren las personas y marcas que deciden apoyar.
        </p>
        <div class="btn-row">
          <a class="btn btn--ember btn--big" href="#donar"><Icon name="heart" /> Elegir cómo donar</a>
          <a class="btn btn--big" href="#patrocinar">Patrocinar como marca</a>
        </div>
      </div>
      <figure class="jar" aria-hidden="true">
        <svg viewBox="0 0 220 240">
          <path d="M60 40h100v18c18 10 30 30 30 56v84a22 22 0 0 1-22 22H52a22 22 0 0 1-22-22v-84c0-26 12-46 30-56z" fill="#16437d" stroke="#06142b" stroke-width="6" stroke-linejoin="round"/>
          <path d="M36 140c26-14 48 12 74 0s48-14 74 0v58a16 16 0 0 1-16 16H52a16 16 0 0 1-16-16z" fill="#fcca2f"/>
          <path d="M36 140c26-14 48 12 74 0s48-14 74 0" fill="none" stroke="#06142b" stroke-width="4"/>
          <rect x="52" y="22" width="116" height="26" rx="8" fill="#cf4c28" stroke="#06142b" stroke-width="6"/>
          <g fill="none" stroke="#06142b" stroke-width="3" opacity=".35">
            <path d="M80 160l12 7v14l-12 7-12-7v-14zM116 168l12 7v14l-12 7-12-7v-14zM152 160l12 7v14l-12 7-12-7v-14z"/>
          </g>
          <path d="M60 80c0-10 6-16 14-18" stroke="#f2f6fc" stroke-width="6" stroke-linecap="round" opacity=".35" fill="none"/>
        </svg>
      </figure>
    </div>
  </section>

  <section class="section" id="donar">
    <div class="wrap">
      <div class="section-head">
        <h2>Cómo donar</h2>
        <p>Cualquier monto ayuda. Elige el método que te acomode.</p>
      </div>
      <DonateMethods variant="full" idPrefix="page" />
      <p class="muted small after">
        Para aparecer en el muro con PayPal o SPEI, mándame tu nombre por <a href={site.links.discord} target="_blank" rel="noopener">Discord</a>.
        Las donaciones son voluntarias y no son la compra de un producto. <a href="/legal/#donaciones">Aviso legal</a>
      </p>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap work">
      <div class="work-head">
        <h2>Un proyecto hecho por una sola persona</h2>
        <p class="lead">
          Programo, pruebo y doy soporte yo solo a cada app y a cada port. Tu apoyo se convierte en horas para seguir
          haciéndolo con calma y con cuidado.
        </p>
      </div>
      <ul class="stats">
        {stats.map((x) => <li><strong>{x.n}</strong><span>{x.label}</span></li>)}
      </ul>
      <ul class="areas">
        {support.work.map((w) => (
          <li>
            <span class="area-ic"><Icon name={w.icon} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="niveles">
    <div class="wrap">
      <div class="section-head">
        <h2>Niveles de la colmena</h2>
        <p>Una forma de dar las gracias según cómo apoyes.</p>
      </div>
      <ul class="tiers">
        {support.tiers.map((t) => (
          <li class={`tier tier--${t.id}${t.featured ? ' tier--featured' : ''}`}>
            <div class="tier-head">
              <TierBadge tier={t.id} size={96} />
              <h3>{t.name}</h3>
              <p class="when">{t.when}</p>
            </div>
            <ul class="perks">
              {t.perks.map((p) => <li><Icon name="check" /> <span>{p}</span></li>)}
            </ul>
            {t.id === 'reina' ? (
              <a class="btn" href={site.links.discord} target="_blank" rel="noopener">Escribir para patrocinar</a>
            ) : t.featured ? (
              <a class="btn btn--ember" href={support.methods.kofi.href} target="_blank" rel="noopener">Apoyar cada mes en Ko-fi</a>
            ) : (
              <a class="btn btn--honey" href="#donar">Donar una vez</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--band" id="patrocinar">
    <div class="wrap">
      <div class="section-head">
        <h2>Patrocinadores</h2>
        <p>Marcas, equipos y creadores que hacen posible el proyecto.</p>
      </div>
      <ul class="sponsors">
        {sponsors.length > 0
          ? sponsors.map((s) => (
              <li class="sp sp--on">
                <a href={s.url ?? '#'} target="_blank" rel="noopener">
                  {s.logo ? <img src={s.logo} alt={s.name} loading="lazy" /> : <span class="sp-name">{s.name}</span>}
                </a>
              </li>
            ))
          : [0, 1, 2, 3].map((i) => (
              <li class="sp">
                <a href={site.links.discord} target="_blank" rel="noopener">
                  <span class="sp-hex" aria-hidden="true"></span>
                  <span>{i === 0 ? 'Tu marca aquí' : 'Lugar disponible'}</span>
                </a>
              </li>
            ))}
      </ul>

      <div class="section-head donors-head" id="muro">
        <h2>Muro de donadores</h2>
        <p>Gracias a cada persona que puso su granito de miel.</p>
      </div>
      {donors.length > 0 ? (
        <DonorWall donors={donors} />
      ) : (
        <div class="donors-empty">
          <p>El muro se llena con cada donación pública. Dona y avísame tu nombre para aparecer aquí.</p>
          <a class="btn btn--honey" href="#donar">Ser de los primeros</a>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Preguntas sobre el apoyo</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(40px, 6vw, 80px); border-bottom: 1px solid var(--line); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .hero-copy { display: grid; gap: 22px; justify-items: start; }
  .jar { margin: 0; justify-self: center; width: min(260px, 70vw); filter: drop-shadow(8px 8px 0 var(--ink)); }
  #donar, #muro, #patrocinar, #niveles { scroll-margin-top: 80px; }
  .after { margin-top: 22px; max-width: 60rem; }
  .work { display: grid; gap: clamp(28px, 4vw, 44px); }
  .work-head { display: grid; gap: 14px; max-width: 46rem; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .stats li { display: grid; gap: 4px; align-content: start; padding: 16px 18px; border-radius: var(--r); background: rgb(6 20 43 / 0.45); border: 1px solid var(--line); }
  .stats strong { font-family: var(--font-display); font-weight: 400; font-size: 2.4rem; line-height: 1; color: var(--honey); font-variant-numeric: tabular-nums; }
  .stats li:last-child strong { color: var(--ember); }
  .stats span { color: var(--mist); font-size: var(--step--1); }
  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .areas li { display: grid; gap: 8px; align-content: start; }
  .areas h3 { font-family: var(--font-body); font-weight: 800; font-size: var(--step-1); }
  .areas p { color: var(--mist); }
  .area-ic {
    width: 46px; height: 50px; display: grid; place-items: center;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--honey); color: var(--ink); margin-bottom: 4px;
  }
  .area-ic :global(svg) { width: 22px; height: 22px; }
  .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .tier {
    display: grid; grid-template-rows: auto 1fr auto; gap: 18px;
    padding: 24px; border-radius: var(--r-lg);
    background: rgb(22 67 125 / 0.5); border: 1px solid var(--line);
  }
  .tier--featured { background: var(--navy); border: var(--stroke); box-shadow: var(--lift-lg); }
  .tier-head { display: grid; gap: 6px; }
  .tier { border-top: 4px solid var(--tc); }
  .tier--abeja { --tc: var(--ember); }
  .tier--obrera { --tc: #d3deee; }
  .tier--reina { --tc: var(--honey); }
  .tier .when { color: var(--tc); font-weight: 700; }
  .tier h3 { font-size: var(--step-2); }
  .when { color: var(--mist); }
  .perks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; align-content: start; }
  .perks li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; }
  .perks :global(svg) { width: 20px; height: 20px; color: var(--honey); margin-top: 3px; }
  .tier .btn { justify-self: start; }
  .sponsors { list-style: none; margin: 0 0 56px; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .sp a {
    display: grid; place-items: center; gap: 10px; text-align: center;
    min-height: 120px; padding: 16px;
    border: 2px dashed rgb(167 187 217 / 0.35); border-radius: var(--r);
    color: var(--mist); text-decoration: none; font-weight: 700;
  }
  .sp a:hover { border-color: var(--honey); color: var(--honey); }
  .sp--on a { border-style: solid; background: var(--navy); }
  .sp--on img { max-height: 72px; object-fit: contain; }
  .sp-name { font-family: var(--font-display); color: var(--paper); }
  .sp-hex { width: 36px; height: 40px; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); background: rgb(167 187 217 / 0.22); }
  .donors-head { margin-bottom: 24px; }
  .donors-empty { display: grid; gap: 14px; justify-items: start; padding: 22px; border: 1px dashed rgb(167 187 217 / 0.35); border-radius: var(--r); color: #d8e2f1; }
  @media (max-width: 960px) {
    .stats, .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tiers { grid-template-columns: 1fr; }
    .sponsors { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) { .hero-inner { grid-template-columns: 1fr; } .jar { width: 180px; } }
  @media (max-width: 520px) { .areas { grid-template-columns: 1fr; } }
</style>
