---
import Icon from './Icon.astro';
import { site, sponsors } from '../config/site';
---
<section class="sband" aria-labelledby="sband-t">
  <div class="wrap sband-inner">
    <div class="copy">
      <h2 id="sband-t">Gratis gracias a quienes apoyan</h2>
      <p>
        No hay versión de pago, anuncios ni funciones bloqueadas. Todo lo programa, prueba y mantiene una sola persona,
        y las donaciones por PayPal, Ko-fi o transferencia se convierten en horas para seguir haciéndolo.
      </p>
      <div class="btn-row">
        <a class="btn btn--ember btn--big" href="/apoyar/#donar"><Icon name="heart" /> Donar</a>
        <a class="btn btn--ghost" href={site.showSponsors ? '/apoyar/#patrocinar' : '/apoyar/#muro'}>{site.showSponsors ? 'Patrocinios y donadores' : 'Muro de donadores'}</a>
      </div>
    </div>
    {site.showSponsors && (
    <ul class="slots" aria-label="Patrocinadores">
      {sponsors.length > 0
        ? sponsors.slice(0, 4).map((s) => (
            <li class="slot slot--on">
              <a href={s.url ?? '/apoyar/'} target="_blank" rel="noopener">
                {s.logo ? <img src={s.logo} alt={s.name} loading="lazy" /> : <span>{s.name}</span>}
              </a>
            </li>
          ))
        : [0, 1, 2].map((i) => (
            <li class="slot">
              <a href="/apoyar/#patrocinar">
                <span class="slot-hex" aria-hidden="true"></span>
                <span>{i === 0 ? 'Tu marca aquí' : 'Lugar disponible'}</span>
              </a>
            </li>
          ))}
    </ul>
    )}
  </div>
</section>

<style>
  .sband { border-block: 1px solid var(--line); background: var(--night-2); }
  .sband-inner {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px); align-items: center;
    padding-block: clamp(48px, 7vw, 88px);
  }
  .copy { display: grid; gap: 18px; justify-items: start; }
  .copy p { color: var(--mist); font-size: var(--step-1); line-height: 1.45; max-width: 40rem; }
  .slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .slot a {
    display: grid; place-items: center; gap: 10px; text-align: center;
    aspect-ratio: 1 / 1.05; max-width: 100%;
    padding: 12px;
    border: 2px dashed rgb(167 187 217 / 0.35);
    border-radius: var(--r);
    color: var(--mist); text-decoration: none; font-weight: 700; font-size: var(--step--1);
  }
  .slot a:hover { border-color: var(--honey); color: var(--honey); }
  .slot-hex {
    width: 40px; height: 44px;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: rgb(167 187 217 / 0.22);
  }
  .slot--on a { border-style: solid; background: var(--navy); }
  .slot--on img { max-height: 70%; object-fit: contain; }
  .sband-inner:not(:has(.slots)) { grid-template-columns: 1fr; }
  @media (max-width: 900px) { .sband-inner { grid-template-columns: 1fr; } }
</style>
