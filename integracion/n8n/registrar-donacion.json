    {
      "parameters": {
        "jsCode": "// Convierte lo que llenaste en el formulario en la petición para la web.\nconst f = $json;\nconst actions = { 'Registrar donación': 'registrar', 'Actualizar datos': 'actualizar', 'Quitar del muro': 'quitar' };\nconst methods = { PayPal: 'paypal', SPEI: 'spei', 'Ko-fi': 'kofi', Otro: 'otro' };\nconst tiers = { Abeja: 'abeja', Obrera: 'obrera', Reina: 'reina' };\nconst action = actions[f['Acción']] || 'registrar';\nreturn [{\n  json: {\n    event_type: 'donation',\n    client_payload: {\n      action,\n      id: action === 'registrar' ? `manual-${Date.now()}-${Math.random().toString(36).slice(2, 8)}` : undefined,\n      name: f['Nombre para el muro'] || '',\n      public: f['¿Aceptó aparecer en el muro?'] === 'Sí',\n      tier: tiers[f['Nivel']],\n      method: methods[f['Método']] || 'otro',\n      amount: f['Monto'] ?? null,\n      currency: f['Moneda'] || 'MXN',\n      links: {\n        tiktok: f['TikTok'] || undefined,\n        twitch: f['Twitch'] || undefined,\n        youtube: f['YouTube'] || undefined,\n        kick: f['Kick'] || undefined,\n        instagram: f['Instagram'] || undefined,\n        x: f['X'] || undefined,\n      },\n      source: 'formulario',\n    },\n  },\n}];\n"
      },
      "id": "f400058a-d73a-406d-81de-5ee353826ab0",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/Lexharden/hive-web/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_type: $json.event_type, client_payload: $json.client_payload }) }}",
        "options": {}
      },
      "id": "60acff77-85ef-48e3-a3d3-f4b06f81d50c",
      "name": "Avisar a hive-web",
