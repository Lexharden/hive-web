        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `Muro de donadores: ${$json.client_payload.action} ${$json.client_payload.name} (${$json.client_payload.public ? 'público' : 'privado'})` }) }}",
        "options": {}
      },
      "id": "52d48944-d4e2-47fa-ad30-0ea11f35f459",
      "name": "Aviso en Discord (opcional)",
